---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import Tag from "@/components/Tag.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { formatDateISO } from "@/utils/formatDateISO";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const timezone = config.site.timezone ?? "Asia/Shanghai";
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    <ul class="space-y-8">
      {
        page.data.map(post => (
          <li>
            <h3 class="text-xl leading-snug">
              <a
                class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
                href={getPostUrl(post.id, post.filePath, locale)}
              >
                {post.data.title}
              </a>
            </h3>
            <p class="mt-1">{post.data.description}</p>
            <p class="text-muted-foreground mt-1 text-sm">
              {formatDateISO(post.data.pubDatetime, timezone)}
            </p>
            {post.data.tags.length > 0 && (
              <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {post.data.tags.map(tag => (
                  <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
